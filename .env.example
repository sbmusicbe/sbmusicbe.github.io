# Copy this file's contents into your Vercel project's Environment Variables
# (Project Settings → Environment Variables). Never commit a real .env file.

# Garmin Connect login the backend uses to fetch your stats.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Optional but usually required in production: Garmin blocks logins from
# cloud/datacenter IPs (like Vercel's) with a CAPTCHA/MFA step the backend
# can't solve. Run `npm run garmin:login` locally (see README) and paste its
# output here to let the backend reuse a real session instead of logging in
# fresh each time. Leave unset to fall back to plain GARMIN_EMAIL/PASSWORD
# login (works locally, often fails when deployed).
GARMIN_TOKENS={"oauth1":{...},"oauth2":{...}}

# Anthropic API key that powers the chatbot's answers.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Restrict the API to requests from your own site (CORS). Use your real
# domain in production, e.g. https://sbmusic.be
ALLOWED_ORIGIN=https://sbmusic.be

# Optional shared passphrase so random site visitors can't run up your
# Anthropic bill or hammer your Garmin login. Leave blank to disable.
CHAT_PASSPHRASE=change-me
