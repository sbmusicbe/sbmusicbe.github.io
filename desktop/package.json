{
  "name": "klose-desktop",
  "version": "1.0.0",
  "description": "Klose als Windows-programma (omhulsel rond de website)",
  "main": "main.js",
  "author": "SB Music",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "build": {
    "appId": "be.sbmusic.klose",
    "productName": "Klose",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "offline.html"],
    "win": { "icon": "build/icon.png", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": true, "perMachine": false },
    "artifactName": "Klose-${version}-${target}.${ext}"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
