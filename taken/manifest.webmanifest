{
  "id": "./",
  "name": "Klose",
  "short_name": "Klose",
  "description": "Klose, de CRM voor hardsales. Deals, opvolging en verkopen, versleuteld en gesynchroniseerd.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "background_color": "#F4F1EA",
  "theme_color": "#111318",
  "icons": [
    {
      "src": "icon.svg?v=3",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Nieuwe deal",
      "short_name": "Nieuw",
      "url": "./?new=1",
      "icons": [
        {
          "src": "icon-192.png?v=3",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Klanten",
      "url": "./?view=clients",
      "icons": [
        {
          "src": "icon-192.png?v=3",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Alle deals",
      "url": "./?view=all",
      "icons": [
        {
          "src": "icon-192.png?v=3",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Verkopen",
      "url": "./?view=sales",
      "icons": [
        {
          "src": "icon-192.png?v=3",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
